{
  "name": "vynox-api",
  "version": "1.0.0",
  "description": "Backend API for the Vynox Security Monitor dashboard. Talks to WP sites running the Vynox Connector plugin, stores everything in MongoDB.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch-path=./routes --watch-path=./services --watch-path=./models --watch-path=server.js --watch-path=.env server.js"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "mongoose": "^8.7.0",
    "playwright": "^1.47.0",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "basic-ftp": "^5.0.5",
    "sharp": "^0.33.5",
    "nodemailer": "^6.9.15",
    "imapflow": "^1.0.98",
    "mailparser": "^3.7.1"
  }
}
